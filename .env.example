# Public browser configuration; never put a service-role key in a VITE_ variable.
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
VITE_GA4_MEASUREMENT_ID="G-XXXXXXXXXX"

# Server-only Supabase credentials. Set app_metadata.role="admin" for admin users.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Google Analytics 4 Data API service account (grant it Viewer access to the property).
GA4_PROPERTY_ID="YOUR_NUMERIC_PROPERTY_ID"
GA4_CLIENT_EMAIL="analytics-reader@YOUR_PROJECT.iam.gserviceaccount.com"
GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

PORT="8787"
